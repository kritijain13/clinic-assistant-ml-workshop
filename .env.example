# Copy to clinic_assistant/.env for local development. Replace placeholders locally;
# never commit .env or real credentials.
MYSQL_HOST=your_mysql_host
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=replace_with_mysql_password
MYSQL_DATABASE=your_mysql_database

SESSION_SECRET_KEY=replace_with_random_session_secret
MCP_SECRET_KEY=replace_with_random_mcp_secret
SUPER_ADMIN_ID=your_admin_id
SUPER_ADMIN_PASSWORD=replace_with_admin_password

GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
RESEND_API_KEY=your_resend_api_key
REMINDER_FROM_EMAIL=your_verified_sender_email
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
